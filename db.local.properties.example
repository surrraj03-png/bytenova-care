# =====================================================================
# ByteNova Care – Local Database Credentials Override
# Copy this file to "db.local.properties" and update with your local MySQL credentials.
# Note: "db.local.properties" is ignored by Git to keep passwords secure.
# =====================================================================

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/healthcare_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8
db.username=root
db.password=YOUR_MYSQL_ROOT_PASSWORD
